# =============================================================================
# Multilingual Video Dubbing System - environment
# Copy to .env  ->  cp .env.example .env
# =============================================================================

COMPOSE_PROJECT_NAME=mvds

# ---------------------------------------------------------------------------
# Uncommon port block (473xx-479xx) so nothing clashes with the usual
# 3000 / 5432 / 5678 / 8000 / 9000 suspects already running on this machine.
#   47300 frontend · 47432 postgres · 47678 n8n · 47800 ai-service
#   47900 minio api · 47901 minio console
# Container-INTERNAL ports are untouched; only the published/native ones moved.
# ---------------------------------------------------------------------------
TZ=Asia/Ho_Chi_Minh

# ----------------------------------------------------------------------------
# PostgreSQL (shared: n8n schema + app schema)
# ----------------------------------------------------------------------------
POSTGRES_USER=mvds
POSTGRES_PASSWORD=mvds_dev_password
POSTGRES_DB=mvds
POSTGRES_PORT=47432

# n8n uses its own DB user/schema inside the same instance
N8N_DB_NAME=n8n
N8N_DB_USER=n8n
N8N_DB_PASSWORD=n8n_dev_password

# App (ai-service) DB
APP_DB_NAME=dubbing
APP_DB_USER=dubbing
APP_DB_PASSWORD=dubbing_dev_password

# ----------------------------------------------------------------------------
# n8n
# ----------------------------------------------------------------------------
N8N_PORT=47678
N8N_HOST=localhost
N8N_PROTOCOL=http
WEBHOOK_URL=http://localhost:47678/
GENERIC_TIMEZONE=Asia/Ho_Chi_Minh
N8N_ENCRYPTION_KEY=change-me-32-chars-minimum-secret-key
N8N_BASIC_AUTH_ACTIVE=false
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=admin
# Base URL the n8n HTTP Request nodes use to reach the AI service.
#   http://host.docker.internal:8000  -> AI service running natively on the host (default)
#   http://ai-service:8000            -> AI service inside compose (--profile docker-ai)
AI_SERVICE_BASE_URL=http://host.docker.internal:47800
# Same choice, for the nginx proxy in the frontend container.
AI_SERVICE_UPSTREAM=host.docker.internal:47800
N8N_UPSTREAM=n8n:5678

# ----------------------------------------------------------------------------
# MinIO (S3-compatible object storage)
# ----------------------------------------------------------------------------
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
MINIO_API_PORT=47900
MINIO_CONSOLE_PORT=47901
MINIO_BUCKET=dubbing-jobs
# Endpoint the AI SERVICE uses. Default targets the native run (ports are
# published by compose). docker-compose.yml overrides it to minio:9000 when the
# service runs inside the network (--profile docker-ai).
MINIO_ENDPOINT=localhost:47900
# Endpoint used to build browser-facing presigned URLs
MINIO_PUBLIC_ENDPOINT=localhost:47900
MINIO_SECURE=false

# ----------------------------------------------------------------------------
# AI service
# ----------------------------------------------------------------------------
AI_SERVICE_PORT=47800
LOG_LEVEL=INFO
LOG_JSON=true

# storage backend: minio | local
STORAGE_BACKEND=minio
# Paths for a NATIVE run (relative to the project root). Compose overrides both
# with absolute in-container paths.
LOCAL_STORAGE_ROOT=./data/jobs
SCRATCH_ROOT=./data/jobs/_scratch

# Database URL used by a NATIVE run. Compose overrides it for the container.
# Keep the credentials in sync with APP_DB_USER / APP_DB_PASSWORD / APP_DB_NAME.
DATABASE_URL=postgresql+psycopg://dubbing:dubbing_dev_password@localhost:47432/dubbing

# device: auto | cpu | cuda | mps      (auto -> cuda > mps > cpu)
#   mps = Apple Silicon GPU. Only reachable when the service runs NATIVELY;
#   Docker Desktop on macOS has no Metal passthrough.
DEVICE=auto
# Device used when the AI service runs inside a container (never mps).
DOCKER_AI_DEVICE=cpu
# Per-component overrides - "auto" inherits DEVICE. Handy if one backend
# misbehaves on Metal. Note ASR always falls back to cpu on macOS because
# faster-whisper/CTranslate2 has no Metal backend.
ASR_DEVICE=auto
SEPARATION_DEVICE=auto
DIARIZATION_DEVICE=auto
TRANSLATION_DEVICE=auto
TTS_DEVICE=auto
COMPUTE_TYPE=auto            # auto | int8 | int8_float16 | float16 | float32
TORCH_NUM_THREADS=4

# ---- ASR ----
# Which audio Whisper reads.
#   original = the untouched mix (DEFAULT). Whisper was trained on noisy audio;
#              Demucs' vocal isolation leaves artefacts it has never seen.
#              Measured on data/samples/dialogue_37s.mp4: original -> 18 clean
#              punctuated lines, vocals stem -> 11 run-on lines with no
#              punctuation. Everything downstream repeats whatever this stage
#              produces, so this is the single highest-impact setting here.
#   speech   = the Demucs vocals stem. Try it when music truly buries the
#              dialogue. Diarization + voice references always use the stem.
ASR_AUDIO_SOURCE=original
WHISPER_MODEL=medium         # tiny|base|small|medium|large-v3
WHISPER_VAD_FILTER=true
WHISPER_BEAM_SIZE=5

# Whisper returns decoder windows, not utterances: with the VAD filter on, one
# window can span the silence it was never spoken over ("Call it, Captain."
# reported as 61.38 -> 115.05). Dubbing divides by that span, so the windows are
# re-cut into utterances first. See docs/quality.md and
# ai-service/app/services/segmentation.py.
ASR_MAX_SEGMENT_SECONDS=12.0     # hard ceiling for one dubbing segment
ASR_SPLIT_GAP_SECONDS=0.7        # a pause this long between words ends an utterance
ASR_MIN_SEGMENT_SECONDS=0.35     # shorter fragments are folded into the neighbour
ASR_NO_SPEECH_THRESHOLD=0.8      # only drops a window when avg_logprob is ALSO bad

# ---- Diarization (pyannote.audio 4.x) ----
# Get a token at https://hf.co/settings/tokens and accept the conditions of
# https://hf.co/pyannote/speaker-diarization-community-1  (that ONE repo is enough:
# community-1 is a complete pipeline, segmentation-3.0 is no longer a separate step).
HUGGINGFACE_TOKEN=
DIARIZATION_MODEL=pyannote/speaker-diarization-community-1
DIARIZATION_ENABLED=true
# community-1 also returns an "exclusive" diarization (one speaker per instant),
# which is much easier to reconcile with Whisper's coarser timestamps.
DIARIZATION_USE_EXCLUSIVE=true

# ---- Source separation ----
DEMUCS_MODEL=htdemucs
DEMUCS_ENABLED=true
# Static duck applied to the ORIGINAL mix when Demucs is off and the pipeline
# degrades to voice-over. Shallow on purpose: the mixer already ducks the
# background dynamically (MIX_DUCK_*), and stacking both buried the soundtrack.
VOICEOVER_DUCK_DB=-4.0

# ---- Translation ----
TRANSLATION_PRIMARY=nllb
TRANSLATION_FALLBACK=seamless
# 600M is the SMALLEST NLLB and it shows: it translates literally
# ("intellectual enterprises" -> "doanh nghiệp trí tuệ" = business corporations).
# The bigger checkpoints are a drop-in swap - the only cost is the download and
# a slower run. They are also usually more concise, which reduces how hard the
# synchroniser has to compress each take.
#   facebook/nllb-200-distilled-600M   ~2.5 GB   fastest, most literal
#   facebook/nllb-200-distilled-1.3B   ~5.5 GB   noticeably more idiomatic
#   facebook/nllb-200-3.3B             ~17  GB   best, slow on CPU/MPS
NLLB_MODEL=facebook/nllb-200-distilled-600M
SEAMLESS_MODEL=facebook/hf-seamless-m4t-medium
# Floor on how much shorter a duration-aware rendering may be than the natural
# one. Without it the character budget deletes content to hit a number:
#   "All right, listen up." -> "Được rồi."   (lost half the line)
#   "Smash."                -> "Đúng rồi."   (means "that's right")
# A take that overruns can be sped up or compressed later; deleted meaning cannot.
TRANSLATION_MIN_KEEP_RATIO=0.75

# ---- TTS ----
# NOTE ON VIETNAMESE: XTTS-v2 (the voice-cloning engine) covers 17 languages and
# `vi` is NOT one of them, so a Vietnamese job falls back to MMS-TTS: a single
# synthetic voice, no cloning, flat prosody. That is the design, not a fault.
# `GET /languages` reports a `voice_cloning` flag per language.
TTS_PREFER_VOICE_CLONE=true
XTTS_MODEL=tts_models/multilingual/multi-dataset/xtts_v2
MMS_TTS_MODEL_TEMPLATE=facebook/mms-tts-{iso3}
F5_TTS_ENABLED=false

# ---- GPU từ xa: MỘT notebook Colab phục vụ mọi stage nặng --------------------
# Lý do chính là DUNG LƯỢNG ĐĨA, không chỉ tốc độ:
#   whisper-medium              1.4 GB
#   nllb-200-distilled-600M     2.3 GB
#   viXTTS / F5-TTS             2.5-3 GB
# Bật khối này thì máy bạn KHÔNG lưu trọng số nào. Máy này cũng không có CUDA nên
# whisper rơi về CPU int8 và kernel của coqui/F5 không có bản Metal - tức là 4 GB
# đĩa cho những model chạy chậm.
REMOTE_URL=
REMOTE_TOKEN=
REMOTE_TIMEOUT=600
REMOTE_RETRIES=3

# ASR bật RIÊNG vì nó là stage duy nhất upload AUDIO chứ không phải text. Audio
# được nén Opus ~24 kbps trước khi gửi (phim 10 phút ≈ 1.7 MB thay vì 19 MB wav),
# nhưng "chỉ có text rời khỏi máy" không còn đúng nữa. Nếu bạn dub tư liệu không
# được phép chia sẻ thì để tắt và chấp nhận tải whisper về.
REMOTE_ASR_ENABLED=false
REMOTE_ASR_OPUS_KBPS=24

# Dịch chỉ gửi TEXT - phụ đề cả phim vài chục KB. Không có đánh đổi riêng tư hay
# băng thông nào ở đây, chỉ là 2.3 GB đĩa biến mất.
REMOTE_TRANSLATION_ENABLED=false
REMOTE_TRANSLATION_ENGINE=nllb

# ---- Remote TTS (để trống = dùng chung REMOTE_URL ở trên) ---------------------
# F5-TTS và CosyVoice có kernel chưa hỗ trợ Metal, nên trên máy này chúng rơi về
# CPU và một câu mất lâu hơn cả đoạn phim chứa nó. Vấn đề là GPU, không phải model.
# Bật khối này thì RIÊNG bước synthesis đi sang một máy có CUDA; Demucs, Whisper,
# NLLB, pyannote vẫn chạy MPS ở đây. Thứ rời khỏi máy chỉ là một dòng text và vài
# giây audio tham chiếu - video không bao giờ đi lên mạng.
#
# colab/tts_lab.ipynb dựng sẵn phía server và in ra sẵn các dòng cần dán.
# Chỉ đặt REMOTE_TTS_URL khi bạn muốn synthesis đi một GPU KHÁC với ASR/dịch;
# bình thường để trống và nó dùng REMOTE_URL ở trên.
REMOTE_TTS_URL=
REMOTE_TTS_TOKEN=
# Danh sách engine mà endpoint phục vụ, phân cách bằng dấu phẩy. MỖI id thành một
# adapter riêng tên `remote:<id>`, nên so sánh hai model trên một job thật chỉ là
# đổi một tham số:
#
#   curl -X POST localhost:47800/speech/synthesize \
#     -d '{"job_id":"<id>","force_model":"remote:f5_vi"}'
#
# Ép model bằng force_model thì KHÔNG có fallback chain - đúng như một phép so
# sánh cần, vì rơi ngầm sang engine khác là cách làm hỏng kết quả mà không ai
# nhận ra cho tới lúc viết báo cáo.
# Rỗng = một adapter `remote` duy nhất, để server tự chọn (đúng khi endpoint chỉ
# host một model).
# Danh sách id: xem bảng trong colab/README.md.
REMOTE_TTS_ENGINES=
# ISO-639-1, phân cách bằng dấu phẩy. Rỗng = tin endpoint, để nó tự trả 4xx cho
# ngôn ngữ nó không nói được.
REMOTE_TTS_LANGUAGES=vi
# Endpoint có clone giọng không. Quyết định thứ tự ưu tiên trong router VÀ việc có
# pitch-shift theo speaker hay không - phải tắt khi các giọng đã khác nhau thật.
REMOTE_TTS_VOICE_CLONE=true
# Lần gọi đầu đánh thức model trên máy nguội; các lần sau tính bằng giây.
REMOTE_TTS_TIMEOUT=300
# Hết số lần này thì router rơi xuống MMS-TTS thay vì làm hỏng job. Cột `tts_model`
# trong synthesis manifest cho biết segment nào đã rơi.
REMOTE_TTS_RETRIES=3
COQUI_TOS_AGREED=1

# TTS engines wrap every take in silence (MMS-TTS: ~0.41 s before, ~0.28 s
# after). Counted as speech, that padding alone can exceed the slot the line has
# to fit into, and the ratio maths then demands a stretch that damages the words.
TTS_TRIM_SILENCE=true
TTS_TRIM_THRESHOLD_DB=-45.0
TTS_TRIM_KEEP_MS=40
# When a take still overruns, re-read it faster before resorting to a post-hoc
# time-stretch (degrades the voice) or a re-translation (another model round).
TTS_SPEED_ADAPTATION=true
TTS_MAX_SPEAKING_RATE=1.45
# Tell speakers apart when the engine cannot clone. MMS-TTS ships ONE voice per
# language, so every character in a Vietnamese dub is read by the same person -
# a two-hander sounds like someone arguing with themselves. Each speaker gets a
# small pitch offset instead, ordered by screen time (the busiest keeps the
# natural voice). Ignored when XTTS clones, because then they already differ.
TTS_SPEAKER_PITCH_ENABLED=true
TTS_SPEAKER_PITCH_STEPS=0,-2.5,2.5,-4,4,-1.5,1.5

# ---- Synchronization thresholds ----
SYNC_RATIO_ACCEPT_MIN=0.90
SYNC_RATIO_ACCEPT_MAX=1.10
SYNC_RATIO_STRETCH_MIN=0.80
SYNC_RATIO_STRETCH_MAX=1.20
SYNC_MAX_RETRANSLATE_ATTEMPTS=2

# ---- Mixing ----
BACKGROUND_GAIN_DB=-6.0
SPEECH_GAIN_DB=0.0
# TTS output level varies by ~10 dB between engines. Level the dubbed track to a
# known peak first, so the gains above are a creative choice, not a lottery.
SPEECH_AUTO_GAIN=true
SPEECH_TARGET_PEAK_DBFS=-3.0
SPEECH_AUTO_GAIN_LIMIT_DB=12.0
# Duck the background WHILE the dub speaks (sidechain compression) instead of
# turning the whole soundtrack down. A flat gain cannot do both: either the
# score buries the voice, or the film loses its score.
MIX_DUCK_ENABLED=true
MIX_DUCK_RATIO=8.0
MIX_DUCK_THRESHOLD=0.03
MIX_DUCK_ATTACK_MS=20.0
MIX_DUCK_RELEASE_MS=400.0
# Wet/dry blend: below 1.0 it bounds how far the background can ever be pushed
# down, so a dialogue-dense scene cannot silence the soundtrack outright.
MIX_DUCK_MIX=0.85
LOUDNORM_ENABLED=true
LOUDNORM_I=-16
LOUDNORM_TP=-1.5
LOUDNORM_LRA=11

# ---- Model cache ----
# These are the NATIVE paths (relative to the project root). docker-compose.yml
# overrides them with /models/... which is the mounted volume inside the
# container. Absolute paths work too; anything unwritable falls back to
# ~/.cache/mvds and is reported by /health/ready.
HF_HOME=./models/huggingface
TORCH_HOME=./models/torch
XDG_CACHE_HOME=./models/cache

# ---- Frontend ----
FRONTEND_PORT=47300
