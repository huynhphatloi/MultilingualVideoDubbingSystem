        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ source_filename: 'form-upload', target_language: $json['Target Language'], source_language: ($json['Source Language'] && $json['Source Language'] !== 'auto') ? $json['Source Language'] : null, options: { burn_subtitles: $json['Burn Subtitles'] === 'yes', origin: 'n8n-form' } }) }}",
        "options": {
          "timeout": 60000,
          "response": {
            "response": {
              "neverError": false,
              "responseFormat": "json"
            }
          }
        }
      },
      "id": "ec7e72a2-9de5-4b6b-b743-a99383918d97",
      "name": "Create Processing Job",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -820,
        300
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000,
      "notes": "POST /jobs - reserves a job_id and the jobs/<id>/ prefix in MinIO.",
      "notesInFlow": true,
      "alwaysOutputData": false
    },
    {
      "parameters": {
        "jsCode": "// The HTTP node above replaced the item, so re-attach the uploaded file\n// from the Form Trigger and normalise the binary key to `video`.\nconst form = $('Form: Upload Video').first();\nconst keys = Object.keys(form.binary || {});\nif (!keys.length) {\n  throw new Error('No file was uploaded by the form');\n}\nreturn [{ json: $input.first().json, binary: { video: form.binary[keys[0]] } }];"
      },
      "id": "ac868d66-5258-465a-92e3-f42d89ffb12b",
      "name": "Attach Video Binary",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -600,
        300
      ],
      "notes": "Carries the uploaded file forward without pushing it through every node.",
      "notesInFlow": true
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.AI_SERVICE_BASE_URL || 'http://ai-service:8000' }}/jobs/{{ $json.job_id }}/upload",
        "sendBody": true,
        "contentType": "multipart-form-data",
        "bodyParameters": {
          "parameters": [
            {
              "parameterType": "formBinaryData",
              "name": "file",
              "inputDataFieldName": "video"
            },
            {
              "name": "target_language",
              "value": "={{ $('Form: Upload Video').first().json['Target Language'] }}"
            }
          ]
        },
        "options": {
          "timeout": 1800000
        }
      },
      "id": "45babfa5-039b-4ca0-bdf4-ad4ebffb8d2f",
