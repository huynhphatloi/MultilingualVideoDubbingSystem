          "values": [
            {
              "fieldLabel": "Video",
              "fieldType": "file",
              "acceptFileTypes": ".mp4,.mkv,.mov,.webm,.m4v",
              "requiredField": true
            },
            {
              "fieldLabel": "Target Language",
              "fieldType": "dropdown",
              "fieldOptions": {
                "values": [
                  {
                    "option": "vi"
                  },
                  {
                    "option": "en"
                  },
                  {
                    "option": "ja"
                  },
                  {
                    "option": "ko"
                  },
                  {
                    "option": "zh"
                  },
                  {
                    "option": "fr"
                  },
                  {
                    "option": "de"
                  },
                  {
                    "option": "es"
                  },
                  {
                    "option": "th"
                  },
                  {
                    "option": "id"
                  }
                ]
              },
              "requiredField": true
            },
            {
              "fieldLabel": "Source Language",
              "fieldType": "text",
              "placeholder": "auto",
              "requiredField": false
            },
            {
              "fieldLabel": "Burn Subtitles",
              "fieldType": "dropdown",
              "fieldOptions": {
                "values": [
                  {
                    "option": "no"
                  },
                  {
                    "option": "yes"
                  }
                ]
              },
              "requiredField": false
            }
          ]
        },
        "responseMode": "onReceived",
        "options": {
          "respondWithOptions": {
            "values": {
              "respondWith": "text",
              "formSubmittedText": "Job accepted. Follow the progress at http://localhost:47300"
            }
          }
        }
      },
      "id": "5fbafcce-8b7f-453d-a62a-c88115bf85cf",
