      "id": "0bd18971-d5c4-4f07-8131-f84f8a377011",
      "name": "Frontend Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        -620,
        620
      ],
      "webhookId": "9cde2800-dc5b-41c8-933e-bde73b995011",
      "notes": "The demo frontend calls this webhook after FastAPI stores the uploaded video.",
      "notesInFlow": true
    },
    {
      "parameters": {
        "jsCode": "const body = $json.body || $json;\nif (!body.job_id) throw new Error('job_id is required');\nreturn [{ json: { job_id: body.job_id } }];"
      },
      "id": "0bd18971-d5c4-4f07-8131-f84f8a377012",
      "name": "Prepare Frontend Job",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -400,
        620
      ],
      "notes": "Normalizes the webhook payload before the visible processing stages.",
      "notesInFlow": false
    },
    {
      "parameters": {
        "jsCode": "const form = $input.first();\nconst keys = Object.keys(form.binary || {});\nif (!keys.length) throw new Error('No video was uploaded');\n\n// Dropdown labels read 'Vietnamese (vi)' and 'large-v3 - best quality'.\nconst codeOf = (label, fallback) => {\n  const match = String(label || '').match(/\\(([a-z]{2})\\)\\s*$/);\n  return match ? match[1] : fallback;\n};\nconst firstWord = (label, fallback) =>\n  String(label || fallback).trim().split(/\\s+/)[0] || fallback;\nconst chosenSource = String(form.json['Source Language'] || '');\n\nreturn [{\n  json: {\n    target_language: codeOf(form.json['Target Language'], 'vi'),\n    source_language: /^detect/i.test(chosenSource) ? 'auto' : codeOf(chosenSource, 'auto'),\n    model: firstWord(form.json['Whisper Model'], 'small'),\n    translation_engine: firstWord(form.json['Translation Engine'], 'nllb'),\n    tts_engine: firstWord(form.json['Voice Engine'], 'mms')\n  },\n  binary: { video: form.binary[keys[0]] }\n}];"
      },
      "id": "0bd18971-d5c4-4f07-8131-f84f8a377002",
      "name": "Prepare Upload",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -840,
        300
      ],
      "notes": "Technical adapter: dropdown labels to language codes, and a predictable binary key.",
      "notesInFlow": false
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://ai-service:8000/jobs/upload",
        "sendBody": true,
        "contentType": "multipart-form-data",
        "bodyParameters": {
          "parameters": [
            {
              "parameterType": "formBinaryData",
              "name": "file",
              "inputDataFieldName": "video"
            },
            {
              "name": "target_language",
              "value": "={{ $json.target_language }}"
            },
            {
              "name": "source_language",
              "value": "={{ $json.source_language }}"
            },
            {
              "name": "model",
              "value": "={{ $json.model }}"
            },
            {
              "name": "translation_engine",
              "value": "={{ $json.translation_engine }}"
            },
            {
              "name": "tts_engine",
              "value": "={{ $json.tts_engine }}"
            }
          ]
        },
        "options": {
          "timeout": 1800000
        }
      },
      "id": "0bd18971-d5c4-4f07-8131-f84f8a377003",
      "name": "1. Upload Video",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -620,
        300
      ],
      "notes": "Creates data/jobs/<job_id> and stores the source video.",
      "notesInFlow": true
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://ai-service:8000/stages/extract",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ job_id: $json.job_id }) }}",
        "options": {
          "timeout": 1800000
        }
      },
      "id": "0bd18971-d5c4-4f07-8131-f84f8a377004",
      "name": "2. Extract Audio",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -400,
        300
      ],
      "notes": "FFmpeg creates a 16 kHz ASR file and a 48 kHz soundtrack file.",
      "notesInFlow": true
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://ai-service:8000/stages/transcribe",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ job_id: $json.job_id }) }}",
        "options": {
          "timeout": 7200000
        }
      },
      "id": "0bd18971-d5c4-4f07-8131-f84f8a377005",
      "name": "3. Speech to Text",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -180,
        300
      ],
      "notes": "Calls Whisper on Google Colab and returns text with original start/end timestamps.",
      "notesInFlow": true
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://ai-service:8000/stages/translate",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ job_id: $json.job_id }) }}",
        "options": {
          "timeout": 7200000
        }
      },
      "id": "0bd18971-d5c4-4f07-8131-f84f8a377006",
      "name": "4. Translate",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        40,
        300
      ],
      "notes": "Calls NLLB-200 on Google Colab and writes translated.srt.",
      "notesInFlow": true
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://ai-service:8000/stages/synthesize",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ job_id: $json.job_id }) }}",
        "options": {
          "timeout": 10800000
        }
      },
      "id": "0bd18971-d5c4-4f07-8131-f84f8a377007",
      "name": "5. Generate Voice",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        260,
        300
      ],
      "notes": "Calls MMS-TTS on Google Colab. The workflow fails if Colab is unavailable; there is no local fallback.",
      "notesInFlow": true
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://ai-service:8000/stages/mix",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ job_id: $json.job_id }) }}",
        "options": {
          "timeout": 3600000
        }
      },
      "id": "0bd18971-d5c4-4f07-8131-f84f8a377008",
      "name": "6. Mix and Synchronize",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        480,
        300
      ],
      "notes": "Places each voice at its Whisper timestamp and lowers the original soundtrack.",
