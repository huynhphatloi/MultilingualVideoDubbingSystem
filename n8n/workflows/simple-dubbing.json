      "typeVersion": 4.2,
      "position": [
        480,
        300
      ],
      "notes": "The chosen translation model on the AI backend. Skipped when source and target match.",
      "notesInFlow": true
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://ai-service:8000/stages/voice_references",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ job_id: $json.job_id }) }}",
        "options": {
