      "id": "0bd18971-d5c4-4f07-8131-f84f8a377011",
      "name": "Frontend Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        -620,
        620
      ],
      "webhookId": "9cde2800-dc5b-41c8-933e-bde73b995011",
      "notes": "The demo frontend calls this webhook after FastAPI stores the uploaded video.",
      "notesInFlow": true
    },
    {
      "parameters": {
        "jsCode": "const body = $json.body || $json;\nif (!body.job_id) throw new Error('job_id is required');\nreturn [{ json: { job_id: body.job_id } }];"
      },
      "id": "0bd18971-d5c4-4f07-8131-f84f8a377012",
      "name": "Prepare Frontend Job",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -400,
        620
      ],
      "notes": "Normalizes the webhook payload before the visible processing stages.",
      "notesInFlow": false
    },
    {
      "parameters": {
        "jsCode": "const form = $input.first();\nconst keys = Object.keys(form.binary || {});\nif (!keys.length) throw new Error('No video was uploaded');\n\n// Dropdown labels read 'Vietnamese (vi)' and 'large-v3 - best quality'.\nconst codeOf = (label, fallback) => {\n  const match = String(label || '').match(/\\(([a-z]{2})\\)\\s*$/);\n  return match ? match[1] : fallback;\n};\nconst firstWord = (label, fallback) =>\n  String(label || fallback).trim().split(/\\s+/)[0] || fallback;\nconst flag = (label, fallback) => {\n  const word = firstWord(label, '').toLowerCase();\n  if (word === 'on') return 'true';\n  if (word === 'off') return 'false';\n  return fallback;\n};\nconst chosenSource = String(form.json['Source Language'] || '');\n\n// Only the model fields the operator actually chose are sent. Anything left\n// blank falls through to the AI service's own default, so the form never has\n// to know what that default is.\nconst payload = {\n  target_language: codeOf(form.json['Target Language'], 'vi'),\n  source_language: /^detect/i.test(chosenSource) ? 'auto' : codeOf(chosenSource, 'auto'),\n  asr_model: firstWord(form.json['Speech Recognition Model'], ''),\n  translation_model: firstWord(form.json['Translation Model'], ''),\n  tts_model: firstWord(form.json['Voice Model'], ''),\n  enable_diarization: flag(form.json['Speaker Diarization'], 'false'),\n  enable_alignment: flag(form.json['Duration Alignment'], 'true'),\n  enable_source_separation: flag(form.json['Source Separation'], 'false'),\n  enable_lip_sync: flag(form.json['Lip Sync'], 'false'),\n};\n\n// 'Automatic' means: let the AI service decide from the engine's own\n// reference_required flag, which is what omitting the field does.\nconst cloning = flag(form.json['Voice Cloning'], '');\nif (cloning) payload.enable_voice_cloning = cloning;\n\n// The legacy names are still accepted by the API; the new ones are clearer.\nreturn [{ json: payload, binary: { video: form.binary[keys[0]] } }];"
      },
      "id": "0bd18971-d5c4-4f07-8131-f84f8a377002",
      "name": "Prepare Upload",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -840,
        300
      ],
      "notes": "Technical adapter: dropdown labels to language codes, and a predictable binary key.",
      "notesInFlow": false
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://ai-service:8000/jobs/upload",
        "sendBody": true,
        "contentType": "multipart-form-data",
        "bodyParameters": {
          "parameters": [
            {
              "parameterType": "formBinaryData",
              "name": "file",
              "inputDataFieldName": "video"
            },
            {
              "name": "target_language",
              "value": "={{ $json.target_language || '' }}"
            },
            {
              "name": "source_language",
              "value": "={{ $json.source_language || '' }}"
            },
            {
              "name": "asr_model",
              "value": "={{ $json.asr_model || '' }}"
            },
            {
              "name": "translation_model",
              "value": "={{ $json.translation_model || '' }}"
            },
            {
              "name": "tts_model",
              "value": "={{ $json.tts_model || '' }}"
            },
            {
              "name": "enable_diarization",
              "value": "={{ $json.enable_diarization || '' }}"
            },
            {
              "name": "enable_voice_cloning",
              "value": "={{ $json.enable_voice_cloning || '' }}"
            },
            {
              "name": "enable_alignment",
              "value": "={{ $json.enable_alignment || '' }}"
            },
            {
              "name": "enable_source_separation",
              "value": "={{ $json.enable_source_separation || '' }}"
            },
            {
              "name": "enable_lip_sync",
              "value": "={{ $json.enable_lip_sync || '' }}"
            }
          ]
        },
        "options": {
          "timeout": 1800000
        }
      },
      "id": "0bd18971-d5c4-4f07-8131-f84f8a377003",
      "name": "1. Upload Video",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -620,
