      "id": "0bd18971-d5c4-4f07-8131-f84f8a377001",
      "name": "Upload Form",
      "type": "n8n-nodes-base.formTrigger",
      "typeVersion": 2.2,
      "position": [
        -1240,
        160
      ],
      "webhookId": "ee71780b-5bb5-4460-9fe4-604b12862001",
      "notes": "Static form: only the choices that need no availability check.",
      "notesInFlow": true
    },
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "dubbing/start",
        "responseMode": "onReceived",
        "options": {}
      },
      "id": "0bd18971-d5c4-4f07-8131-f84f8a377011",
      "name": "Frontend Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        -1240,
        520
      ],
      "webhookId": "9cde2800-dc5b-41c8-933e-bde73b995011",
      "notes": "The demo frontend calls this webhook after FastAPI stores the uploaded video.",
      "notesInFlow": true
    },
    {
      "parameters": {
        "jsCode": "const body = $json.body || $json;\nif (!body.job_id) throw new Error('job_id is required');\nreturn [{ json: { job_id: body.job_id } }];"
      },
      "id": "0bd18971-d5c4-4f07-8131-f84f8a377012",
      "name": "Prepare Frontend Job",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -980,
        520
      ],
      "notes": "Normalizes the webhook payload before the visible processing stages.",
      "notesInFlow": false
    },
    {
      "parameters": {
        "jsCode": "const form = $input.first();\nconst keys = Object.keys(form.binary || {});\nif (!keys.length) throw new Error('No video was uploaded');\n\n// Dropdown labels read 'Vietnamese (vi)' and 'edge - Microsoft Edge voices'.\nconst codeOf = (label, fallback) => {\n  const match = String(label || '').match(/\\(([a-z]{2})\\)\\s*$/);\n  return match ? match[1] : fallback;\n};\nconst firstWord = (label, fallback) =>\n  String(label || fallback).trim().split(/\\s+/)[0] || fallback;\nconst chosenSource = String(form.json['Source Language'] || '');\n\n// The AI service applies defaults for settings this static form does not ask for.\nconst payload = {\n  target_language: codeOf(form.json['Target Language'], 'vi'),\n  source_language: /^detect/i.test(chosenSource) ? 'auto' : codeOf(chosenSource, 'auto'),\n  tts_model: firstWord(form.json['Voice Model'], ''),\n};\n\nreturn [{ json: payload, binary: { video: form.binary[keys[0]] } }];"
      },
      "id": "0bd18971-d5c4-4f07-8131-f84f8a377002",
      "name": "Prepare Upload",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -980,
        160
      ],
      "notes": "Technical adapter: dropdown labels to language codes, and a predictable binary key.",
      "notesInFlow": false
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://ai-service:8000/jobs/upload",
        "sendBody": true,
        "contentType": "multipart-form-data",
        "bodyParameters": {
          "parameters": [
            {
              "parameterType": "formBinaryData",
              "name": "file",
              "inputDataFieldName": "video"
            },
            {
              "name": "target_language",
              "value": "={{ $json.target_language || '' }}"
            },
            {
              "name": "source_language",
              "value": "={{ $json.source_language || '' }}"
            },
            {
              "name": "tts_model",
              "value": "={{ $json.tts_model || '' }}"
            }
          ]
        },
        "options": {
          "timeout": 1800000
        }
      },
      "id": "0bd18971-d5c4-4f07-8131-f84f8a377003",
      "name": "1. Upload Video",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -720,
        160
      ],
      "notes": "Creates data/jobs/<job_id> and stores the source video.",
      "notesInFlow": true
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://ai-service:8000/stages/extract",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ job_id: $json.job_id }) }}",
        "options": {
          "timeout": 7200000
        }
      },
      "id": "stage-extract",
      "name": "2. Extract Audio",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -420,
        160
      ],
      "notes": "FFmpeg writes a 16 kHz mono file for the models and a 48 kHz soundtrack for the mix.",
      "notesInFlow": true
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://ai-service:8000/stages/diarize",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ job_id: $json.job_id }) }}",
        "options": {
          "timeout": 7200000
        }
      },
      "id": "stage-diarize",
      "name": "3. Speaker Diarization",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -160,
        160
      ],
      "notes": "Required. pyannote returns speaker turns used for transcript labels and stable per-speaker Edge voices.",
      "notesInFlow": true
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://ai-service:8000/stages/transcribe",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ job_id: $json.job_id }) }}",
        "options": {
          "timeout": 7200000
        }
      },
      "id": "stage-transcribe",
      "name": "4. Speech Recognition",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        100,
        160
      ],
      "notes": "The chosen ASR model on the AI backend. Recognisers without timestamps are given the diarization turns as windows.",
      "notesInFlow": true
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://ai-service:8000/stages/merge_segments",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ job_id: $json.job_id }) }}",
        "options": {
          "timeout": 7200000
        }
      },
      "id": "stage-merge_segments",
      "name": "5. Merge Speakers + Transcript",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        360,
        160
      ],
      "notes": "Local: each segment takes the speaker it overlaps most. No model involved.",
      "notesInFlow": true
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://ai-service:8000/stages/translate",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ job_id: $json.job_id }) }}",
        "options": {
          "timeout": 7200000
        }
      },
      "id": "stage-translate",
      "name": "6. Translate",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -420,
        560
      ],
      "notes": "The chosen translation model on the AI backend. Skipped when source and target match.",
      "notesInFlow": true
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://ai-service:8000/stages/synthesize",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ job_id: $json.job_id }) }}",
        "options": {
          "timeout": 7200000
        }
      },
      "id": "stage-synthesize",
      "name": "7. Generate Voice",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -160,
        560
      ],
      "notes": "The chosen TTS model on the AI backend, one call per segment.",
      "notesInFlow": true
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://ai-service:8000/stages/align",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ job_id: $json.job_id }) }}",
        "options": {
          "timeout": 7200000
        }
      },
      "id": "stage-align",
      "name": "8. Align Speech",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        100,
        560
      ],
      "notes": "Optional. Local FFmpeg fits each line into its own time window, within the configured speed limits.",
      "notesInFlow": true
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://ai-service:8000/stages/separate",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ job_id: $json.job_id }) }}",
        "options": {
          "timeout": 7200000
        }
      },
      "id": "stage-separate",
      "name": "9. Source Separation",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        360,
        560
      ],
      "notes": "Optional. Demucs on the AI backend returns the background stem so the dub is not laid over the original voice.",
      "notesInFlow": true
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://ai-service:8000/stages/mix",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ job_id: $json.job_id }) }}",
        "options": {
          "timeout": 7200000
        }
      },
      "id": "stage-mix",
      "name": "10. Mix Audio",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        700,
        560
      ],
      "notes": "Local FFmpeg places every clip at its timestamp and mixes it with the background.",
      "notesInFlow": true
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://ai-service:8000/stages/render",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ job_id: $json.job_id }) }}",
        "options": {
          "timeout": 7200000
        }
      },
      "id": "stage-render",
      "name": "11. Render Video",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        960,
        560
      ],
      "notes": "Local FFmpeg muxes the dubbed audio and the subtitles back onto the video.",
      "notesInFlow": true
    },
    {
      "parameters": {
        "mode": "manual",
        "assignments": {
          "assignments": [
            {
              "id": "c44192f2-a601-4a2c-8572-e27800000001",
              "name": "job_id",
              "value": "={{ $json.job_id }}",
              "type": "string"
            },
            {
              "id": "c44192f2-a601-4a2c-8572-e27800000002",
              "name": "status",
              "value": "completed",
              "type": "string"
            },
            {
              "id": "c44192f2-a601-4a2c-8572-e27800000003",
              "name": "download_video",
              "value": "={{ $json.output_url }}",
              "type": "string"
            },
            {
              "id": "c44192f2-a601-4a2c-8572-e27800000004",
              "name": "download_subtitle",
              "value": "={{ $json.subtitle_url }}",
              "type": "string"
            },
            {
              "id": "c44192f2-a601-4a2c-8572-e27800000005",
              "name": "source_language",
              "value": "={{ $('6. Translate').first().json.source_language }}",
              "type": "string"
            },
            {
              "id": "c44192f2-a601-4a2c-8572-e27800000006",
              "name": "target_language",
              "value": "={{ $('6. Translate').first().json.target_language }}",
              "type": "string"
            },
            {
              "id": "c44192f2-a601-4a2c-8572-e27800000007",
              "name": "asr_model",
              "value": "={{ $('4. Speech Recognition').first().json.asr_model }}",
              "type": "string"
            },
            {
              "id": "c44192f2-a601-4a2c-8572-e27800000008",
              "name": "segments",
              "value": "={{ $('6. Translate').first().json.segment_count }}",
              "type": "string"
            },
            {
              "id": "c44192f2-a601-4a2c-8572-e27800000009",
              "name": "translation_model",
              "value": "={{ $('6. Translate').first().json.translation_model }}",
              "type": "string"
            },
            {
              "id": "c44192f2-a601-4a2c-8572-e27800000010",
              "name": "tts_model",
              "value": "={{ $('7. Generate Voice').first().json.tts_model }}",
              "type": "string"
            },
            {
              "id": "c44192f2-a601-4a2c-8572-e27800000011",
              "name": "voice_used",
              "value": "={{ Object.keys($('7. Generate Voice').first().json.models_used || {}).join(', ') }}",
              "type": "string"
            },
            {
              "id": "c44192f2-a601-4a2c-8572-e27800000012",
              "name": "speakers",
              "value": "={{ ($('5. Merge Speakers + Transcript').first().json.speakers || []).join(', ') }}",
              "type": "string"
            },
            {
              "id": "c44192f2-a601-4a2c-8572-e27800000013",
              "name": "alignment",
              "value": "={{ JSON.stringify($('8. Align Speech').first().json.alignment || {}) }}",
              "type": "string"
            },
            {
              "id": "c44192f2-a601-4a2c-8572-e27800000014",
              "name": "mix_mode",
              "value": "={{ $('10. Mix Audio').first().json.mode }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "0bd18971-d5c4-4f07-8131-f84f8a377010",
      "name": "Result",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        1220,
        560
      ],
      "notes": "Open these URLs in the browser after the execution is green.",
      "notesInFlow": true
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "b7d0f9c1-6f1e-4a6d-9d0a-2c9f7a1b3001",
              "leftValue": "={{ $('Upload Form').isExecuted ? 'form' : 'api' }}",
              "rightValue": "form",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "looseTypeValidation": true,
        "options": {}
      },
      "id": "0bd18971-d5c4-4f07-8131-f84f8a377013",
      "name": "Came From the Form?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        1220,
        800
      ],
      "notes": "The frontend app polls for itself, so only form runs get the ending page.",
      "notesInFlow": true
    },
    {
      "parameters": {
        "operation": "completion",
        "respondWith": "showText",
        "responseText": "=<p><strong>EXPORT READY</strong></p>\n<h2>Your dubbed video is ready</h2>\n<p>Job <code>{{ $json.job_id }}</code> translated {{ $json.source_language }} to {{ $json.target_language }} across {{ $json.segments }} timed segments.</p>\n<h3>Run summary</h3>\n<ul>\n<li>Speech recognition: <b>{{ $json.asr_model }}</b></li>\n<li>Translation: <b>{{ $json.translation_model }}</b></li>\n<li>Voice: <b>{{ $json.voice_used || $json.tts_model }}</b></li>\n<li>Speakers: <b>{{ $json.speakers || 'SPEAKER_00' }}</b></li>\n<li>Audio mix: <b>{{ $json.mix_mode }}</b></li>\n</ul>\n<h3>Downloads</h3>\n<p><a href=\"{{ $json.download_video }}\" target=\"_blank\" rel=\"noopener\"><b>Download dubbed video (MP4)</b></a></p>\n<p><a href=\"{{ $json.download_subtitle }}\" target=\"_blank\" rel=\"noopener\">Download translated subtitles (SRT)</a></p>\n<p><small>Files remain available while the DubFlow stack is running.</small></p>",
        "limitWaitTime": false,
