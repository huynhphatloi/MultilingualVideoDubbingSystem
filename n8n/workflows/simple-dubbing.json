      ],
      "notes": "Optional. Cuts one clean clip per speaker and uploads it, so cloning keeps each voice distinct.",
      "notesInFlow": true
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://ai-service:8000/stages/synthesize",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ job_id: $json.job_id }) }}",
